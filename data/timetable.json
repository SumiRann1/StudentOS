    "LAL252": {
      "courseCode": "LAL252/LA252",
      "nickname": "LAL252",
      "courseName": "Introduction to Stress and Coping",
      "LTP": "2-0-0",
      "credits": "2/4",
      "discipline": [
        "LA"
      ],
      "program": [
        "BTech"
      ],
      "lectureSlotVenue": [
